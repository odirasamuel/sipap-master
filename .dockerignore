# SIPAP Orchestrator .dockerignore
# Excludes unnecessary files from Docker build context

# Git
.git/
.gitignore
.github/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Linting
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in container)
*.md
!README.md

# Docker
Dockerfile
.dockerignore
docker/

# Logs
logs/
*.log

# Sessions
sessions/

# Development files
.env
.env.local
*.pyc

# macOS
.DS_Store

# Tests (not needed in production container)
tests/

# Build artifacts
sipap_master.egg-info/
